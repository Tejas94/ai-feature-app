# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=

# Any current Claude model id. Opus is the most capable; in week 3 compare
# claude-sonnet-5-5 and claude-haiku-4-5 on eval scores and cost per entry.
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: where saved entries, photos and corrections go (default ./data).
# Point it at a persistent volume when you deploy.
# CATALOG_DATA_DIR=/data/catalog

# Optional: npm run eval exits non-zero when the overall score is below this (0 to 1).
# EVAL_MIN_SCORE=0.8

# Optional: extra hosts allowed to use the dev server (comma-separated), for when the page
# opens on your phone but the buttons do nothing. Home network ranges are already allowed.
# DEV_ORIGINS=my-laptop.example
